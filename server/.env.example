# Example environment file for Red-Berry server
# Do NOT store real API keys in the repository. Create a file at server/.env (ignored) or set env vars.
# Provide Gemini/API keys as a comma-separated list. Example:
# GEMINI_KEYS="AIza... , AIza..."

GEMINI_KEYS=""
# Optional: set model (default: text-bison-001)
GEMINI_MODEL="text-bison-001"
# Session secret for development only
SESSION_SECRET=dev-secret
